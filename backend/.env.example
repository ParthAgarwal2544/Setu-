# Copy this file to .env and fill in your own Supabase project's values.
# Get these from: Supabase Dashboard -> your project -> Project Settings -> API

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_JWT_SECRET=your-jwt-secret-from-project-settings-api
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Leave as-is for local/demo use; swap for a real Postgres URL if you outgrow SQLite.
DATABASE_URL=sqlite+aiosqlite:///./setu.db
CORS_ORIGINS=["http://localhost:3000"]
